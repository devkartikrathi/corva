# ─────────────────────────────────────────────────────────────────────────────
# Corva — environment variables
#
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production, and Preview if you
# use preview deployments). DEPLOYING.md walks through it step by step.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: Neon Postgres (pgvector) — REQUIRED ────────────────────────────
# Pooled connection for the app. The direct (unpooled) connection is for
# migrations and for the live relay when a person takes over a voice call
# (Postgres LISTEN/NOTIFY needs a real session).
DATABASE_URL=postgres://…-pooler…/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://…/neondb?sslmode=require

# ── AI: Google Gemini — REQUIRED ─────────────────────────────────────────────
# Answers, embeddings (knowledge search) and voice (Gemini Live).
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Sign-in: Clerk — REQUIRED in production ──────────────────────────────────
# Use the production instance's keys (pk_live_ / sk_live_) on Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Corva's back office (/admin) — REQUIRED in production ────────────────────
# Comma-separated emails (verified in Clerk) that may open /admin: every
# business, plans, payments, demo requests. Demo requests from /demo are
# emailed to these addresses too.
CORVA_ADMIN_EMAILS=

# ── Businesses' own databases — to let them connect one ──────────────────────
# Seals the connection strings businesses give Corva (Your database). Any long
# random string: `openssl rand -base64 36`. Change it and every business has
# to connect again.
DATA_SOURCE_KEY=

# ── Where Corva lives — RECOMMENDED ──────────────────────────────────────────
# Used for links in emails, the developer docs and the voice address.
# Defaults to the Vercel production URL when unset.
APP_URL=https://corva.example.com

# ── Email: Resend — RECOMMENDED ──────────────────────────────────────────────
# Invitations, customer confirmations and lead notifications. Without a key,
# emails are logged and skipped. Until a sending domain is verified in Resend,
# the default sender only delivers to your own Resend account address.
RESEND_API_KEY=
# EMAIL_FROM="Corva <hello@your-verified-domain.com>"

# ── Voice — RECOMMENDED in production ────────────────────────────────────────
# Signs the short-lived tokens that start browser voice calls. Any long random
# string (e.g. `openssl rand -base64 32`). Defaults to one derived from
# DATABASE_URL, which works but should not be relied on in production.
VOICE_TOKEN_SECRET=
# On Vercel the bridge runs inside Corva at wss://<APP_URL host>/api/voice and
# needs no setting. Only set this if you host the bridge elsewhere.
# VOICE_BRIDGE_PUBLIC_URL=wss://voice.example.com
# Local bridge port for `npm run voice` (development only).
# VOICE_BRIDGE_PORT=8787

# ── Payments: Razorpay — needed to sell plans online ─────────────────────────
# Keys: Razorpay → Account & Settings → API Keys (rzp_test_… / rzp_live_…).
# Without them Billing still shows plans and usage, and plans are set in /admin.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Chosen when you create the webhook in Razorpay (Settings → Webhooks), pointed
# at https://<corva>/api/razorpay/webhook with payment.captured, payment.failed
# and refund.processed. NOT the key secret. Unset, deliveries are refused.
RAZORPAY_WEBHOOK_SECRET=

# ── Modes — local only; ignored on the production deployment ─────────────────
# CORVA_DEMO=1            open demo: no sign-in, a seeded member stands in
# CORVA_DEMO_EMAIL=…      which member demo mode opens the console as

# ── Optional tuning ──────────────────────────────────────────────────────────
# AGENT_CHAT_MODEL=gemini-3.5-flash-lite     what answers website chat, for every business
# AGENT_DEFAULT_MODEL=gemini-3.5-flash       model a new business uses for its other text work
# MODEL_HEDGE_MS=4000                        a stream this slow to start is raced with a second model
# MODEL_FIRST_RESPONSE_MS=30000              give up on a stream that has not started by now
# VOICE_LIVE_MODEL=gemini-3.1-flash-live-preview
# VOICE_SESSION_CAP_SECONDS=180              longest unattended call with the assistant
# VOICE_CALL_LIMIT_SECONDS=290               longest call once a person has taken it (keep under
#                                            the function's maxDuration: 300 on Hobby, up to 800 on Pro)
# VOICE_IDLE_TIMEOUT_SECONDS=45              no audio from the caller for this long ends the call
# VOICE_HELD_IDLE_TIMEOUT_SECONDS=180        …while a person holds the call
# VOICE_MAX_SESSIONS=20                      concurrent calls per instance (2 locally)
