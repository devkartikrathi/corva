# ─────────────────────────────────────────────────────────────────────────────
# Corva — environment variables
#
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production, and Preview if you
# use preview deployments). DEPLOYING.md walks through it step by step.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database: Neon Postgres (pgvector) — REQUIRED ────────────────────────────
# Pooled connection for the app; direct connection for migrations.
DATABASE_URL=postgres://…-pooler…/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://…/neondb?sslmode=require

# ── AI: Google Gemini — REQUIRED ─────────────────────────────────────────────
# Answers, embeddings (knowledge search) and voice (Gemini Live).
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Sign-in: Clerk — REQUIRED in production ──────────────────────────────────
# Use the production instance's keys (pk_live_ / sk_live_) on Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Corva's own console (/operator) ──────────────────────────────────────────
# Runs only on the Corva team's machines (`npm run dev`), against the same
# database; on any Vercel deployment /operator does not exist.

# ── Where Corva lives — RECOMMENDED ──────────────────────────────────────────
# Used for links in emails, the developer docs and the voice address.
# Defaults to the Vercel production URL when unset.
APP_URL=https://corva.example.com

# ── Email: Resend — RECOMMENDED ──────────────────────────────────────────────
# Invitations, customer confirmations and lead notifications. Without a key,
# emails are logged and skipped. Until a sending domain is verified in Resend,
# the default sender only delivers to your own Resend account address.
RESEND_API_KEY=
# EMAIL_FROM="Corva <hello@your-verified-domain.com>"

# ── Voice — RECOMMENDED in production ────────────────────────────────────────
# Signs the short-lived tokens that start browser voice calls. Any long random
# string (e.g. `openssl rand -base64 32`). Defaults to one derived from
# DATABASE_URL, which works but should not be relied on in production.
VOICE_TOKEN_SECRET=
# On Vercel the bridge runs inside Corva at wss://<APP_URL host>/api/voice and
# needs no setting. Only set this if you host the bridge elsewhere.
# VOICE_BRIDGE_PUBLIC_URL=wss://voice.example.com
# Local bridge port for `npm run voice` (development only).
# VOICE_BRIDGE_PORT=8787

# ── Modes — local only; ignored on the production deployment ─────────────────
# CORVA_DEMO=1            open demo: no sign-in, a seeded member stands in
# CORVA_OPERATOR_OPEN=1   open /operator in a local production build (next start)

# ── Optional tuning ──────────────────────────────────────────────────────────
# AGENT_DEFAULT_MODEL=gemini-3.5-flash       model new businesses answer on
# MODEL_FIRST_RESPONSE_MS=15000              wait before trying another model
# VOICE_SESSION_CAP_SECONDS=180              longest voice call (keep < 300 on Vercel)
# VOICE_IDLE_TIMEOUT_SECONDS=45
# VOICE_MAX_SESSIONS=20                      concurrent calls per instance (2 locally)
